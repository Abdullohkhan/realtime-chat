DATABASE_URL=postgresql://chat:chat@localhost:5432/chat
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Frontend manzili (CORS uchun). Bir nechta bo'lsa vergul bilan ajrating.
CORS_ORIGIN=http://localhost:5173

# Telefon orqali kirish: Telegram Gateway tokeni (https://gateway.telegram.org).
# Bo'sh bo'lsa: faqat lokal dev rejimda kod server logiga yoziladi, production'da telefon orqali kirish o'chadi.
TELEGRAM_GATEWAY_TOKEN=
